{
  "name": "@vanillaes/csv",
  "version": "4.0.2",
  "description": "A modern, fast, RFC 4180 compliant parser for JS",
  "keywords": [
    "esm",
    "esmodule",
    "csv",
    "csv-parser",
    "rfc4180"
  ],
  "license": "MIT",
  "contributors": [
    {
      "name": "Evan Plaice",
      "email": "evan.plaice@gmail.com",
      "url": "http://evanplaice.com"
    },
    {
      "name": "Colton Ehrman",
      "email": "coltonje95@gmail.com",
      "url": "http://coltonehrman.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanillaes/csv.git"
  },
  "type": "module",
  "exports": {
    "import": "./src/index.js",
    "types": "./src/index.d.ts",
    "browser": "./src/index.min.js"
  },
  "scripts": {
    "test": "tape-es",
    "test:watch": "tape-es --watch",
    "lint": "esmtk lint",
    "types": "esmtk types ./src/index.js",
    "build": "npm run build:min && npm run build:typings",
    "build:min": "esmtk minify ./src/index.js ./src/index.min.js",
    "build:typings": "esmtk typings ./src/index.js",
    "clean": "npm run clean:builds && npm run clean:typings",
    "clean:builds": "npx rimraf ./src/index.min.js",
    "clean:typings": "npx rimraf ./src/index.d.ts",
    "package": "npx rimraf package && npm pack | tail -n 1 | xargs tar -xf",
    "preversion": "npm test && npm run lint && npm run types",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@vanillaes/esmtk": "^0.9.0",
    "@vanillaes/tape-es": "^2.0.0"
  }
}
